<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider configuration for log export.
  Only the private cache directory is shared, and only the log files inside it,
  so a share target can never read anything else from the app sandbox.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="log_exports"
        path="exports/" />
</paths>
