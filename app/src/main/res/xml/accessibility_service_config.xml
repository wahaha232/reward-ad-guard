<?xml version="1.0" encoding="utf-8"?>
<!--
  RewardAdAccessibilityService configuration.

  Design notes (see DEVELOPMENT_REPORT.md, section "AccessibilityService"):
   * The service is event driven. It does NOT run a polling loop and does NOT
     request FLAG_REQUEST_TOUCH_EXPLORATION_MODE, so normal touch input is never
     intercepted. android:canPerformGestures is true only so the close-button
     guard can dispatch a one-shot tap at the centre of a detected X.
   * No overlay / floating window is used, hence canRetrieveWindowContent only.
   * Only window-state changes are requested here: that is all the guard needs
     while no reward app is in front. RewardAdAccessibilityService widens the
     subscription at runtime (updateEventProfile) - clicks during a session,
     content changes, view ids and not-important views only
     while an ad activity is on screen - because every subscribed type is
     delivered from every app and slowed the whole phone down.
   * No flags by default: flagRetrieveInteractiveWindows made the system rebuild
     its window list for the guard on every window change of every app
     (2026-11-04); view ids are requested at runtime only during an ad.
   * notificationTimeout is 0: with a timeout the system keeps only the last
     event of each type in that window, so the reward app's own screen coming
     back and the reward dialog it opens at once arrived as the dialog alone,
     and the guard never saw the ad close (BitWalk/InMobi, 2026-11-04).
     Content changes are never merged, so 0 adds no events there.
   * canTakeScreenshot is on for the collector's OCR fallback (Android 11+).
     It is used only by ScreenReader when the collector engine explicitly asks
     for a reading, never from an event callback. Below Android 11 the
     attribute is ignored and the accessibility node tree is the only source.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="true"
    android:canRequestTouchExplorationMode="false"
    android:canRequestFilterKeyEvents="false"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="0"
    android:settingsActivity="com.rewardadguard.app.ui.MainActivity"
    android:summary="@string/accessibility_service_summary" />
