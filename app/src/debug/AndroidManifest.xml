<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.

  This file is merged only into the debug variant, so the release APK does not
  contain this receiver at all. The receiver itself additionally checks
  BuildConfig.DEBUG before doing anything.

  Purpose: run the rewarded-ad behaviour tests on demand, without spending the
  once-per-day ad. See TOOLS/auto_test.ps1 and TOOLS/auto_test.md.

  NOTE on exported="false": whether `adb shell am broadcast` can reach a
  non-exported receiver varies by Android version and was NOT verifiable without
  a device. If section T of auto_test.ps1 reports SKIP on a confirmed debug build,
  change this to exported="true" (BuildConfig.DEBUG still gates the code), or move
  the entry point to a debug-only Activity driven by `am start`, which is
  guaranteed to work for an explicit component.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="com.rewardadguard.app.service.DebugTestReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rewardadguard.app.action.DEBUG_TEST" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
