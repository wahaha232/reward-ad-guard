<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.

  This file is merged only into the debug variant, so the release APK does not
  contain the test entry point at all. DebugTestActivity additionally checks
  BuildConfig.DEBUG before doing anything.

  Purpose: run the rewarded-ad behaviour tests on demand, without spending the
  once-per-day ad. See TOOLS/auto_test.ps1 and TOOLS/auto_test.md.

  HISTORY, measured on the POCO X6 Pro (2311DRK48G, Android 16 / HyperOS V816):
  an earlier DebugTestReceiver driven by `adb shell am broadcast` was
  UNREACHABLE, because a broadcast from the shell cannot force-start a stopped
  app's process - it reaches ActivityManager and `am` still prints
  `Broadcast completed: result=0`, but no process starts and onReceive never
  runs. `exported="true"` did not help, and adding a `signature` permission only
  added a second way to fail.

  The receiver has been REMOVED (ISS-09): with the shell unable to drive it, and
  all scripts on DebugTestActivity, it was dead weight whose command set had
  drifted from the Activity's.

  ADB-driven tests use DebugTestActivity below, whose explicit Activity start has
  no "existing process" escape hatch: with `exported="false"` it fails loudly
  with a SecurityException, which is exactly the behaviour a test instrument
  needs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          The entry point that `adb shell` can actually reach.

          `exported="true"` is REQUIRED here, and this is measured, not assumed:
          with `exported="false"` the shell is rejected with
          `SecurityException: Permission Denial: starting Intent {...} from null
          (pid=..., uid=2000) not exported from uid <app>`.

          Unlike the broadcast case, an Activity start from the shell has no
          "start an already-running process" escape hatch, so `am start -n` on a
          non-exported activity fails loudly. That loud failure is the reason this
          is the reliable test entry point.

          Exposure is bounded by: this overlay is debug-only (never merged into
          release), and DebugTestActivity re-checks BuildConfig.DEBUG on create.
        -->
        <activity
            android:name="com.rewardadguard.app.debug.DebugTestActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>

</manifest>
