# Normalize line endings so the repository always stores LF.
#
# Why this file exists: the working copy on Windows uses CRLF, but the blobs
# already committed are LF. With `core.autocrlf=false` that mismatch turned
# *.kt files into 300+ line "changes" whose only real difference was the line
# terminator, hiding the handful of lines that were actually modified.
#
# `text=auto` makes git convert to LF on the way in and back to CRLF on the way
# out (because core.autocrlf is now true), so diffs only ever show real edits.
* text=auto

# Gradle wrapper scripts must keep LF: a CRLF `gradlew` fails on Linux/macOS.
gradlew text eol=lf
*.sh    text eol=lf

# Windows-only launchers keep their native CRLF.
gradlew.bat text eol=crlf

# Binary assets must never be line-ending converted.
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.keystore binary
*.jks   binary
