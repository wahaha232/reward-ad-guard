*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Gradle / AGP build output for every module (the bare "/build" above only
# covers the root project; app/build/ was being committed as a result).
build/
.kotlin/

# Keystores must never be committed.
*.jks
*.keystore

# Device-dump scratch files produced by the TOOLS/ scripts.
TOOLS/*.xml
/dump*.xml

# Field test reports. `TOOLS/field_test.ps1` writes one on every run, named with
# a timestamp (`reward_ad_guard_field_test_YYYYMMDD_HHMMSS.txt`), so committing
# them would add a new file to the repo per run and bury the real changes.
# They are diagnostic output, meant to be sent back for analysis, not kept.
TOOLS/reward_ad_guard_field_test_*.txt

# Remote test run directories. `TOOLS/remote_test.ps1` creates one
# (`run_<timestamp>/`) per invocation, containing console.txt, per-step raw
# output and a copy of the device DB. Same reasoning as above: diagnostic
# output that is sent back for analysis, not kept - and a per-run directory
# would otherwise add a dozen files to the repo every time it is used.
TOOLS/remote_test_reports/
